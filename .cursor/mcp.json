{
  "mcpServers": {
    "kicad": {
      "type": "stdio",
      "command": "uvx",
      "args": ["kicad-mcp-pro"],
      "env": {
        "KICAD_MCP_PROJECT_DIR": "${workspaceFolder}/circuits/led_blinker",
        "KICAD_MCP_PROFILE": "schematic_only",
        "KICAD_MCP_OPERATING_MODE": "write"
      }
    }
  }
}
