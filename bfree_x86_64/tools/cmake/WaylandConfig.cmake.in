# Generated by B-Free install_wayland_cmake_configs.sh — cross libwayland for guest QtWayland.
include(FindPackageHandleStandardArgs)

set(_bfree_wayland_prefix "@PREFIX@")
set(_bfree_libffi_prefix "@LIBFFI_PREFIX@")
file(TO_CMAKE_PATH "${_bfree_wayland_prefix}" _bfree_wayland_prefix)

set(Wayland_VERSION "@VERSION@")
set(Wayland_INCLUDE_DIRS "${_bfree_wayland_prefix}/include")
set(Wayland_LIBRARIES "")
set(Wayland_FOUND TRUE)

foreach(_comp IN ITEMS Client Server Cursor Egl)
  string(TOLOWER "${_comp}" _lc)
  set(_lib "${_bfree_wayland_prefix}/lib/libwayland-${_lc}.a")
  set(_hdr "${_bfree_wayland_prefix}/include/wayland-${_lc}.h")
  if(NOT EXISTS "${_lib}" OR NOT EXISTS "${_hdr}")
    message(STATUS "B-Free Wayland: missing ${_comp} (${_lib})")
    set(Wayland_${_comp}_FOUND FALSE)
    set(Wayland_FOUND FALSE)
    continue()
  endif()
  set(Wayland_${_comp}_FOUND TRUE)
  set(Wayland_${_comp}_INCLUDE_DIR "${_bfree_wayland_prefix}/include")
  set(Wayland_${_comp}_LIBRARY "${_lib}")
  list(APPEND Wayland_LIBRARIES "${_lib}")
  if(NOT TARGET Wayland::${_comp})
    add_library(Wayland::${_comp} STATIC IMPORTED)
    set_target_properties(Wayland::${_comp} PROPERTIES
      IMPORTED_LOCATION "${_lib}"
      INTERFACE_INCLUDE_DIRECTORIES "${_bfree_wayland_prefix}/include"
    )
  endif()
endforeach()

if(TARGET Wayland::Client AND TARGET Wayland::Egl)
  set_property(TARGET Wayland::Egl APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "Wayland::Client")
endif()

if(TARGET Wayland::Client AND EXISTS "${_bfree_libffi_prefix}/lib/libffi.a")
  set_property(TARGET Wayland::Client APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "${_bfree_libffi_prefix}/lib/libffi.a")
endif()

find_package_handle_standard_args(Wayland
  FOUND_VAR Wayland_FOUND
  REQUIRED_VARS Wayland_LIBRARIES
  VERSION_VAR Wayland_VERSION
  HANDLE_COMPONENTS
)
