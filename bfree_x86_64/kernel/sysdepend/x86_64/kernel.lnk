ENTRY(_start)

SECTIONS
{
  . = 0x100000;

  /* Multiboot2 header: VMA/LMAともに1MB、KEEPで除去防止 */
  .multiboot2 0x100000 : {
    KEEP(*(.multiboot2))
  }

  /* .text以降は4Kアライン */
  . = ALIGN(4K);
  .text : {
    *(.text .text.*)
  }

  .rodata ALIGN(4K) : {
    *(.rodata .rodata.*)
  }

  .data ALIGN(4K) : {
    *(.data .data.*)
  }


  .bss ALIGN(4K) (NOLOAD) : {
    _bss_start = .;
    *(.bss .bss.*)
    *(COMMON)
    _bss_end = .;
  }

  /*
   * Large page_table_t + PMM bitmap + kstack must NOT sit in the BusyBox
   * guest window (0x500000–~0x578000). Identity VA==PA aliases there let the
   * guest execute kernel stack (#UD @0x525EA0 with LE(VA) bytes) or let
   * bitmap/stack traffic wipe guest .text.
   *
   * Place them just above that window; stay below loader staging @0x04E00000
   * and Multiboot initrd VA @0x05000000.
   * Section name avoids .bss.* so the wildcard above does not suck them in.
   */
  /*
   * page_table_t ≈ 656KiB. Residents in .bfree_page_table:
   *   kernel_page_table + task_page_tables[2] + g_child_page_table
   *   + g_fork_page_table[BFREE_PROC_MAX_LIVE]  (MAX_LIVE=4 → 8 objects)
   * ≈ 8 * 656KiB ≈ 5.1MiB. Keep the window ≥ 6MiB (was 4MiB @0xA00000 —
   * MAX_LIVE=4 overflowed into pmm_bitmap and caused guest #PF after fork).
   */
  . = 0x00600000;
  _bfree_khi_start = .;
  .bfree_page_table ALIGN(4K) (NOLOAD) : {
    *(.bfree_page_table)
  }

  . = 0x00C00000;
  .pmm_bitmap ALIGN(4K) (NOLOAD) : {
    _pmm_bitmap_start = .;
    . = . + 0x20000; /* 4GiB / 4KiB / 8 = 128KiB */
    _pmm_bitmap_end = .;
  }

  /DISCARD/ : { *(.note.GNU-stack) }

  .stack ALIGN(4K) (NOLOAD) : {
    _stack_start = .;
    *(.stack)
    _stack_end = .;
  }
  _bfree_khi_end = .;
}
