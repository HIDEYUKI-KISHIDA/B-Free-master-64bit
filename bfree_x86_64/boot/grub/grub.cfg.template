set timeout=5
set default=0

menuentry "B-Free OS (compositor + Wayland desktop)" {
    multiboot2 /boot/kernel.elf
    module2 /boot/compositor.elf compositor.elf
    module2 /boot/init.elf init.elf
    module2 /boot/desktop.elf desktop.elf
    module2 /boot/busybox.elf busybox.elf
    boot
}

menuentry "B-Free OS (GUI — init + desktop, legacy fbdev QPA)" {
    multiboot2 /boot/kernel.elf
    module2 /boot/init.elf init.elf
    module2 /boot/desktop.elf desktop.elf
    module2 /boot/busybox.elf busybox.elf
    boot
}

menuentry "B-Free OS (busybox serial — AUTO_LOGIN)" {
    multiboot2 /boot/kernel.elf
    module2 /boot/init.elf init.elf
    module2 /boot/busybox.elf busybox.elf
    boot
}

menuentry "B-Free OS (busybox only)" {
    multiboot2 /boot/kernel.elf
    module2 /boot/shell.elf shell.elf
    module2 /boot/busybox.elf busybox.elf
    boot
}
